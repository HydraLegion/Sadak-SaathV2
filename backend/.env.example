# Sadak Saathi Backend — Environment Configuration

# Flask
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=config/firebase-credentials.json
FIREBASE_PROJECT_ID=your-project-id

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI/ML Configuration
YOLO_MODEL_PATH=models/yolov8n-pothole.pt
YOLO_CONFIDENCE_THRESHOLD=0.7
MAX_FRAME_SKIP=5
VIDEO_SAMPLE_RATE=2

# Upload Configuration
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=500
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
ALLOWED_VIDEO_TYPES=mp4,mov,avi

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=100
MAX_REPORTS_PER_USER_PER_DAY=5

# SLA Configuration (in days)
SLA_CRITICAL=3
SLA_HIGH=7
SLA_MEDIUM=14
SLA_LOW=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry
SENTRY_DSN=

# CORS
CORS_ORIGINS=http://localhost:3000,https://sadaksaathi.gov.in

# JWT
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
