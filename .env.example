# Sadak Saathi — Environment Configuration

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Map Configuration
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_HEATMAP=true
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=50
NEXT_PUBLIC_DETECTION_CONFIDENCE_THRESHOLD=0.7

# App Configuration
NEXT_PUBLIC_APP_NAME="Sadak Saathi"
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SUPPORT_EMAIL=support@sadaksaathi.gov.in

# Rate Limiting
NEXT_PUBLIC_MAX_REPORTS_PER_DAY=5
NEXT_PUBLIC_MAX_REPORTS_PER_HOUR=2

# SLA Configuration (in days)
NEXT_PUBLIC_SLA_CRITICAL=3
NEXT_PUBLIC_SLA_HIGH=7
NEXT_PUBLIC_SLA_MEDIUM=14
NEXT_PUBLIC_SLA_LOW=30
